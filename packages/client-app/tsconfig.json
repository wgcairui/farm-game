{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "tsBuildInfoFile": ".tsbuild/dist.tsbuildinfo",
    "noEmit": false,
    "jsx": "react-native",
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "test", "node_modules"],
  "references": [{ "path": "../shared" }]
}