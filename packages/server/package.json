{
  "name": "@farm-game/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./app": "./dist/app.js",
    "./admin": "./dist/admin/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "test:integration": "MAIN_DB_URL=${MAIN_DB_URL:-postgres://farm:farm@127.0.0.1:5432/farm_game_test} node --test --test-concurrency=1 --import tsx test/integration/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "dev:ws": "tsx watch src/realtime/serve.ts",
    "start:ws": "node dist/realtime/serve.js",
    "clean": "rm -rf dist",
    "db:up": "docker compose -f compose.yml up -d postgres redis nginx",
    "db:down": "docker compose -f compose.yml down",
    "db:reset": "docker compose -f compose.yml down -v && docker compose -f compose.yml up -d postgres",
    "db:logs": "docker compose -f compose.yml logs -f --tail=100 postgres redis nginx",
    "db:shell": "docker compose -f compose.yml exec ${SERVICE:-nginx} sh",
    "db:status": "docker compose -f compose.yml ps",
    "db:migrate": "node --import tsx src/db/migrate.ts up",
    "db:migrate:test": "TEST_DB_URL=postgres://farm:farm@127.0.0.1:5432/farm_game_test node --import tsx src/db/migrate.ts up",
    "db:lint": "docker compose -f compose.yml config -q",
    "demo:loop": "node --import tsx scripts/demo-loop.ts",
    "smoke": "node --import tsx scripts/smoke-protocol.ts",
    "smoke:realtime": "node --import tsx scripts/smoke-realtime.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.12",
    "@colyseus/redis-driver": "0.18.2",
    "@colyseus/redis-presence": "0.18.4",
    "@colyseus/ws-transport": "^0.18.2",
    "@farm-game/client-app": "workspace:*",
    "@farm-game/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.2.2",
    "@mikro-orm/core": "^6.2.0",
    "@mikro-orm/migrations": "^6.2.0",
    "@mikro-orm/postgresql": "^6.2.0",
    "fast-jwt": "^6.3.3",
    "fastify": "^5.12.3",
    "pg": "^8.11.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.2",
    "@colyseus/testing": "0.18.5",
    "@colyseus/tools": "0.18.3",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "ws": "^8.21.3"
  }
}