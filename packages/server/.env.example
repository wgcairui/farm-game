# Copy to `.env` (gitignored) and adjust. None of these values are safe
# for production. Per ADR-0001 §4, production MUST set explicit secrets
# and disable mock auth.

# ─── HTTP server ───
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# ─── CORS (browser/H5 debug only; WeChat mini-program wx.request ignores CORS) ───
# Comma-separated allow-list, e.g. "https://admin.example.com,http://localhost:5173".
# Leave empty: non-production reflects any origin, production refuses all.
# Required in production if any browser-based client (admin panel, Swagger) is wired.
CORS_ORIGIN=

# ─── Auth (development defaults — DO NOT use in production) ───
JWT_SECRET=dev-secret-change-me
JWT_SECRET_ADMIN=dev-admin-secret-change-me
SESSION_SECRET=dev-session-change-me
JWT_ISSUER=farm-game
JWT_AUDIENCE=client
JWT_TTL_SEC=604800

# ENABLE_MOCK_AUTH=1 enables /auth/wechat mock path. Forbidden in production.
ENABLE_MOCK_AUTH=1
# ENABLE_ADMIN=1 mounts @colyseus/admin on the WS node. Off by default.
ENABLE_ADMIN=0

# ─── Database (G1, ADR-0003) ───
# Main business DB — used by HTTP routes and the farm command services.
MAIN_DB_URL=postgres://farm:farm@127.0.0.1:5432/farm_game
# Integration test DB — created by compose/db-init on first boot.
TEST_DB_URL=postgres://farm:farm@127.0.0.1:5432/farm_game_test

# Colyseus / admin DB — not used in G1 (placeholder kept for parity with config.ts).
ADMIN_DB_URL=
# ─── Realtime WS server (G2 T2) ───
# Standalone Colyseus process; independent from the HTTP entry.
WS_HOST=127.0.0.1
WS_PORT=2567

# Redis coordinates the matchmaker directory + presence across WS processes.
# Leave empty for a single-process dev boot on the in-process driver.
# In production the WS entry refuses to start without it (the HTTP entry
# does not use Redis and is unaffected).
# Host port 6380 (compose maps 127.0.0.1:6380→6379): 6379 collides with
# other local projects / port forwards on this machine.
REDIS_URL=redis://127.0.0.1:6380/0

# Farm room ownership lease (PostgreSQL is the single arbiter).
# LEASE_RENEW_MS must be shorter than LEASE_TTL_MS, and the failure budget
# LEASE_RENEW_MS × 2 (consecutive tolerated renew failures) must stay below
# LEASE_TTL_MS.
LEASE_TTL_MS=15000
LEASE_RENEW_MS=5000

# T4: how often the WS process polls players.revision for its active rooms to
# detect out-of-band writes (HTTP entry / another device) and push a fresh
# full snapshot to connected clients.
REFRESH_POLL_MS=1000

# T4: reconnection seat TTL offered when a client drops abnormally. The
# reconnecting client keeps its auth and must pull a fresh snapshot via
# farm_refresh.
ROOM_RECONNECT_TTL_SEC=60
