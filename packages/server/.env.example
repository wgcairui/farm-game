# Copy to `.env` (gitignored) and adjust. None of these values are safe
# for production. Per ADR-0001 §4, production MUST set explicit secrets
# and disable mock auth.

# ─── HTTP server ───
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# ─── Auth (development defaults — DO NOT use in production) ───
JWT_SECRET=dev-secret-change-me
JWT_SECRET_ADMIN=dev-admin-secret-change-me
SESSION_SECRET=dev-session-change-me
JWT_ISSUER=farm-game
JWT_AUDIENCE=client
JWT_TTL_SEC=604800

# ENABLE_MOCK_AUTH=1 enables /auth/wechat mock path. Forbidden in production.
ENABLE_MOCK_AUTH=1
# ENABLE_ADMIN=1 mounts @colyseus/admin on the WS node. Off by default.
ENABLE_ADMIN=0

# ─── Database (G1, ADR-0003) ───
# Main business DB — used by HTTP routes and the farm command services.
MAIN_DB_URL=postgres://farm:farm@127.0.0.1:5432/farm_game
# Integration test DB — created by compose/db-init on first boot.
TEST_DB_URL=postgres://farm:farm@127.0.0.1:5432/farm_game_test

# Colyseus / admin DB — not used in G1 (placeholder kept for parity with config.ts).
ADMIN_DB_URL=
# ─── Realtime WS server (G2 T2) ───
# Standalone Colyseus process; independent from the HTTP entry.
WS_HOST=127.0.0.1
WS_PORT=2567

# Redis coordinates the matchmaker directory + presence across WS processes.
# Leave empty for a single-process dev boot on the in-process driver.
# In production the WS entry refuses to start without it (the HTTP entry
# does not use Redis and is unaffected).
REDIS_URL=redis://127.0.0.1:6379/0

# Farm room ownership lease (PostgreSQL is the single arbiter).
# LEASE_RENEW_MS must be shorter than LEASE_TTL_MS.
LEASE_TTL_MS=15000
LEASE_RENEW_MS=5000
